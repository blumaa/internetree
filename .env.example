# Copy to .env.local. Unset → the app runs the local single-browser sim (offline dev).
# Set both → the app uses the shared remote tree via the `tree` Edge Function.
#
# Local Supabase (supabase start) prints these:
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<local anon key from `supabase start`>
#
# Production: from the Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
